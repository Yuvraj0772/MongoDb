<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>

    <table border="1">
        <tr>
            <td>Name</td>
            <td>Age</td>
            <td>Email</td>
            <td>Action</td>
        </tr>

<% students.forEach(students=> { %>
     <tr>
            <td><%= students.name %></td>
            <td><%= students.age %></td>
            <td><%= students.email %></td>
            <td><a href="/ui/delete/<%= students._id %>">Delete</a></td>
        </tr>
<% }) %>
    
    </table>
    
</body>
</html>